{
  "name": "forma-creative-studio",
  "version": "0.2.0",
  "private": true,
  "customElements": "./custom-elements.json",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "node scripts/generate-custom-elements-manifest.mjs && node --experimental-strip-types scripts/check-system-localization.mjs && node build/clean-dist.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview",
    "test": "node scripts/generate-custom-elements-manifest.mjs && node --experimental-strip-types scripts/check-system-localization.mjs && node build/clean-dist.mjs && vite build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:a11y": "playwright test --config=playwright.a11y.config.mjs",
    "cem": "node scripts/generate-custom-elements-manifest.mjs",
    "cem:check": "node scripts/generate-custom-elements-manifest.mjs --check",
    "i18n:check": "node --experimental-strip-types scripts/check-system-localization.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist",
    "setup:local-encryption": "node scripts/setup-local-encryption-root.mjs",
    "replay": "node --experimental-strip-types scripts/replay.mjs",
    "eval:image-adapters": "node --experimental-strip-types scripts/run-image-adapter-eval.mjs",
    "eval:image-adapters:preflight": "node --experimental-strip-types scripts/run-image-adapter-eval.mjs --preflight-only=true",
    "eval:image-adapters:cycle": "node --experimental-strip-types scripts/run-image-adapter-cycle-search.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-local.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@phosphor-icons/core": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lit": "3.3.3",
    "signal-polyfill": "0.2.2",
    "signal-utils": "0.21.1",
    "three": "0.185.1",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/three": "0.185.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
