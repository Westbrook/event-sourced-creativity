{
  "name": "forma-creative-studio",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "node build/clean-dist.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview",
    "test": "node build/clean-dist.mjs && vite build && node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist",
    "replay": "node --experimental-strip-types scripts/replay.mjs",
    "eval:image-adapters": "node --experimental-strip-types scripts/run-image-adapter-eval.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lit": "3.3.3",
    "signal-polyfill": "0.2.2",
    "signal-utils": "0.21.1",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
