{
  "version": 1,
  "principles": ["Every pointer affordance has a keyboard path", "Single-letter commands are inactive in text fields", "Escape cancels the current mode", "Bindings are discoverable from the command palette and help overlay"],
  "bindings": [
    {"domain":"global","keys":["Meta+K"],"command":"Open command palette","implemented":true},
    {"domain":"global","keys":["Meta+Z","Shift+Meta+Z"],"command":"Undo or redo own events","implemented":true},
    {"domain":"global","keys":["?"],"command":"Open Canvas reading-order help","implemented":true},
    {"domain":"global","keys":["Escape"],"command":"Cancel the current Canvas dialog or mode","implemented":true},
    {"domain":"semantic-list","keys":["Meta+\\"],"command":"Toggle semantic parity list","implemented":true},
    {"domain":"selection","keys":["ArrowLeft","ArrowRight","ArrowUp","ArrowDown"],"command":"Nudge one unit; Shift nudges ten","implemented":true},
    {"domain":"formalize","keys":["F"],"command":"Confirm selected items as a named context set","implemented":true},
    {"domain":"create","keys":["N"],"command":"Open all 21 block types including Sketch","implemented":true},
    {"domain":"create","keys":["E"],"command":"Edit one selected shared block","implemented":true},
    {"domain":"create","keys":["Delete","Backspace"],"command":"Remove selected Canvas placements","implemented":true},
    {"domain":"comparison","keys":["C"],"command":"Compare two to four selected items","implemented":true},
    {"domain":"viewport","keys":["+","-","Meta+0","Meta+1"],"command":"Zoom, fit, and reset","implemented":true},
    {"domain":"object-menu","keys":["Shift+F10","Meta+."],"command":"Open provenance, lock, restore, re-home, and copy actions","implemented":false},
    {"domain":"ink","keys":["P","E","Space","Enter"],"command":"Keyboard pen and exact-stroke erase","implemented":false},
    {"domain":"lenses","keys":["V","Shift+V"],"command":"Open or clear URL-only lens","implemented":false},
    {"domain":"chat","keys":["Meta+J"],"command":"Open the active document conversation","implemented":false}
  ]
}
