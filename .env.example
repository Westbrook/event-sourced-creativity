# Local development only. Production values are configured through Sites.
OPENAI_API_KEY=
OPENAI_PROJECT=
OPENAI_MODEL=gpt-5.6-terra
# Optional slideshow-only routes; omit to retain OPENAI_MODEL (then Terra) / low defaults.
# Both workflows must use a supported model and effort before any paid slideshow call.
# Explicitly changing composition does not implicitly change editorial repair.
# OPENAI_SLIDES_COMPOSITION_MODEL=gpt-5.6-terra
# OPENAI_SLIDES_COMPOSITION_REASONING_EFFORT=low
# OPENAI_SLIDES_REPAIR_MODEL=gpt-5.6-terra
# OPENAI_SLIDES_REPAIR_REASONING_EFFORT=low
# See docs/presentation-model-routing.md for supported values and budget/rollout rules.
OPENAI_IMAGE_MODEL=gpt-image-2
FORMA_IMAGE_PROVIDER=openai
FAL_IMAGE_MODEL=ideogram/v4
FAL_IMAGE_PREVIEW_MODEL=ideogram/v4/fast
FAL_IMAGE_EDIT_MODEL=ideogram/v4/image-to-image
FAL_VIDEO_MODEL=bytedance/seedance-2.0/reference-to-video
FAL_AUDIO_MODEL=fal-ai/lyria3/pro
FAL_REFERENCE_VIDEO_MODEL=bytedance/seedance-2.0/reference-to-video
FORMA_VIDEO_PROVIDER=fal
FORMA_AUDIO_PROVIDER=fal
FAL_KEY=
FORMA_ADMIN_EMAILS=
# Page-aware guidance is available to all authorized users; explicit IDs gate privileged, editing, and paid features.
FORMA_ASSISTANT_INTERNAL_USER_IDS=
FORMA_ASSISTANT_ACTION_USER_IDS=
FORMA_ASSISTANT_PROVIDER_USER_IDS=
FORMA_ASSISTANT_SOL_USER_IDS=
FORMA_ASSISTANT_ALLOWED_MODELS=gpt-5.6-luna,gpt-5.6-terra
FORMA_RETENTION_DAYS=30
FORMA_EVIDENCE_RETENTION_DAYS=365
FORMA_PILOT_COHORT_ID=
# Optional 32-byte hexadecimal or base64 development root; never commit a real key.
FORMA_ENCRYPTION_ROOT_KEY=
# Optional versioned JSON keyring; keep historical roots available until old snapshots expire.
FORMA_ENCRYPTION_ROOT_KEYS=
FORMA_ENCRYPTION_ROOT_KEY_VERSION=
FORMA_USER_TOKEN_LIMIT=10000000
FORMA_WORKSPACE_TOKEN_LIMIT=100000000
FORMA_USER_COST_LIMIT_USD=100
FORMA_WORKSPACE_COST_LIMIT_USD=1000
