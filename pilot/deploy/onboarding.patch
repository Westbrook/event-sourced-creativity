diff --git a/terraform/reve-prototyping/user-namespaces.tf b/terraform/reve-prototyping/user-namespaces.tf
index 5f07050..a751fee 100644
--- a/terraform/reve-prototyping/user-namespaces.tf
+++ b/terraform/reve-prototyping/user-namespaces.tf
@@ -277,3 +277,37 @@ resource "google_project_iam_member" "agentobservability_registry_writer" {
   role    = "roles/artifactregistry.writer"
   member  = "serviceAccount:${google_service_account.agentobservability.email}"
 }
+
+# still-platform-pilot -- https://github.com/reve-ai/still-platform-pilot
+resource "google_service_account" "still_platform_pilot" {
+  project      = var.project_id
+  account_id   = "still-platform-pilot"
+  display_name = "still-platform-pilot prototype workload + CI identity"
+}
+
+resource "google_service_account_iam_member" "still_platform_pilot_wif" {
+  service_account_id = google_service_account.still_platform_pilot.id
+  role               = "roles/iam.workloadIdentityUser"
+  member             = "principalSet://iam.googleapis.com/${var.github_identity_pool_id}/attribute.repository/reve-ai/still-platform-pilot"
+}
+
+# Lets pods using the namespace's KSA (manifests.yaml) actually mint
+# tokens as this GSA -- the binding above only covers GitHub's CI
+# identity, not the in-cluster Workload Identity direction.
+resource "google_service_account_iam_member" "still_platform_pilot_ksa_wif" {
+  service_account_id = google_service_account.still_platform_pilot.id
+  role               = "roles/iam.workloadIdentityUser"
+  member             = "serviceAccount:${var.project_id}.svc.id.goog[still-platform-pilot/still-platform-pilot]"
+}
+
+resource "google_project_iam_member" "still_platform_pilot_cluster_viewer" {
+  project = var.project_id
+  role    = "roles/container.clusterViewer"
+  member  = "serviceAccount:${google_service_account.still_platform_pilot.email}"
+}
+
+resource "google_project_iam_member" "still_platform_pilot_registry_writer" {
+  project = var.project_id
+  role    = "roles/artifactregistry.writer"
+  member  = "serviceAccount:${google_service_account.still_platform_pilot.email}"
+}
