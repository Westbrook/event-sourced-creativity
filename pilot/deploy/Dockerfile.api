ARG NODE_IMAGE=node:24.16.0-bookworm-slim
FROM ${NODE_IMAGE}
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack pnpm install --frozen-lockfile --ignore-scripts
COPY pilot/package.json pilot/package-lock.json ./pilot/
RUN npm ci --prefix pilot --ignore-scripts --omit=dev --no-audit --no-fund
COPY src ./src
COPY worker ./worker
COPY pilot/src ./pilot/src
COPY pilot/sql ./pilot/sql
USER node
ENV NODE_ENV=production PILOT_BIND=0.0.0.0 PORT=8080
EXPOSE 8080
CMD ["node","--import","tsx","pilot/src/api.mjs"]
