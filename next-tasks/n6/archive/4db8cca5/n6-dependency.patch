+  "buildNote": "pnpm initially attempted dependency reconciliation and aborted before a module purge. npm run invoked the same checked-in build script successfully using existing local dependencies; no install or package edits."
+}
diff --git a/tests/browser/n6-source-advisory-review.test.mjs b/tests/browser/n6-source-advisory-review.test.mjs
new file mode 100644
index 00000000..076b96ae
--- /dev/null
+++ b/tests/browser/n6-source-advisory-review.test.mjs
@@ -0,0 +1,91 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {chromium, expect} from '@playwright/test';
+import {createN6ReviewServer} from '../helpers/n6-source-advisory-review-fixture.mjs';
+
+test('N6 unavailable-inspector boundary preserves N5 item attribution and explicit acknowledgement', async () => {
+  const {server, url} = await createN6ReviewServer();
+  let browser;
+  try {
+    browser = await chromium.launch({headless: true});
+    const page = await browser.newPage({viewport: {width: 1280, height: 950}});
+    page.setDefaultTimeout(15000);
+    const errors = [], externalRequests = [];
+    page.on('pageerror', error => errors.push(error.message));
+    await page.route('**/*', route => {
+      if (new URL(route.request().url()).origin === new URL(url).origin) return route.continue();
+      externalRequests.push(route.request().url());
+      return route.abort();
+    });
+    await page.goto(url);
+    const dock = page.locator('.action-dock');
+    const button = name => dock.getByRole('button', {name, exact: true});
+    await expect(button('Generate')).toBeVisible();
+    assert.deepEqual(await page.evaluate(() => window.n6Trace), {requests: [], unexpectedFetches: [], acknowledgedRequests: 0, createdJobs: 0});
+    assert.equal(await page.evaluate(() => window.n6App.client.jobs.length), 0);
+
+    await button('Generate').click();
+    await expect(button('Acknowledge & send')).toBeVisible();
+    const known = page.locator('#generation-context-known .context-review-reason');
+    await expect(known).toContainText('flagged: hate');
+    await expect(known).not.toContainText('violence');
+    await expect(page.locator('#generation-context-empty .context-review-reason')).toContainText('category unavailable');
+    await expect(page.locator('#generation-context-legacy .context-review-reason')).toHaveCount(0);
+    await expect(page.locator('#generation-context-clear .context-review-reason')).toHaveCount(0);
+    await expect(page.locator('#generation-context-empty')).toContainText('<img data-n6-injected="true"');
+    await expect(page.locator('[data-n6-injected]')).toHaveCount(0);
+    assert.equal(await page.evaluate(() => window.n6MarkupExecuted), undefined);
+    await expect(page.locator('n6-review-fixture').getByRole('button', {name: /inspect|raw|evidence/i})).toHaveCount(0);
+    await expect(page.locator('n6-review-fixture a[href*="inspection"], n6-review-fixture a[href*="advisory"]')).toHaveCount(0);
+    assert.equal(await page.evaluate(() => window.n6Readiness.advisoryCapture.inspection), 'unavailable-before-admission');
+
+    // Reading/reflowing the warning has no acknowledgement or job side effect.
+    await page.setViewportSize({width: 390, height: 844});
+    await expect(button('Acknowledge & send')).toBeVisible();
+    assert.equal(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth + 1), true);
+    const before = await page.evaluate(() => ({trace: window.n6Trace, jobs: window.n6App.client.jobs.length, acknowledgements: window.n6App.generation.acknowledgements ?? {}}));
+    assert.equal(before.trace.requests.length, 1);
+    assert.equal(before.trace.requests[0].payload.preflightAcknowledged, undefined);
+    assert.equal(before.trace.acknowledgedRequests, 0);
+    assert.equal(before.trace.createdJobs, 0);
+    assert.equal(before.jobs, 0);
+    assert.deepEqual(before.acknowledgements, {});
+
+    await button('Acknowledge & send').click();
+    await expect.poll(() => page.evaluate(() => window.n6Trace.acknowledgedRequests)).toBe(1);
+    await expect(button('Check request')).toBeDisabled();
+    const during = await page.evaluate(() => window.n6Trace);
+    assert.equal(during.requests.length, 2);
+    assert.equal(during.createdJobs, 0);
+    const original = structuredClone(during.requests[0]), acknowledged = structuredClone(during.requests[1]);
+    assert.equal(acknowledged.payload.preflightAcknowledged, true);
+    delete acknowledged.payload.preflightAcknowledged;
+    assert.deepEqual(acknowledged, original, 'the explicit acknowledgement retains the original request and source');
+    await page.getByText('Fixture counters and retained request', {exact: true}).click();
+    await page.getByRole('button', {name: 'Finish synthetic acknowledgement', exact: true}).click();
+    await expect(page.getByRole('heading', {name: 'Synthetic acknowledgement accepted'})).toBeVisible();
+    const after = await page.evaluate(() => ({trace: window.n6Trace, jobs: window.n6App.client.jobs.length, pending: window.n6App.client.pendingGeneration}));
+    assert.equal(after.trace.requests.length, 2);
+    assert.equal(after.trace.acknowledgedRequests, 1);
+    assert.equal(after.trace.createdJobs, 1);
+    assert.equal(after.jobs, 1);
+    assert.equal(after.pending, null);
+    assert.deepEqual(after.trace.unexpectedFetches, []);
+
+    await page.goto(`${url}?variant=legacy`);
+    await button('Generate').click();
+    await expect(button('Acknowledge & send')).toBeVisible();
+    const legacy = page.locator('#generation-context-legacy .context-review-reason');
+    await expect(legacy).toContainText('individual categories were not recorded');
+    await expect(legacy).not.toContainText('violence');
+    assert.equal(await page.evaluate(() => window.n6Trace.requests.length), 1);
+    assert.equal(await page.evaluate(() => window.n6Trace.acknowledgedRequests), 0);
+    assert.equal(await page.evaluate(() => window.n6App.client.jobs.length), 0);
+    assert.deepEqual(await page.evaluate(() => window.n6Trace.unexpectedFetches), []);
+    assert.deepEqual(externalRequests, []);
+    assert.deepEqual(errors, []);
+  } finally {
+    await browser?.close();
+    await server.close();
+  }
+});
diff --git a/tests/helpers/n6-source-advisory-review-fixture.mjs b/tests/helpers/n6-source-advisory-review-fixture.mjs
new file mode 100644
index 00000000..287d2bb9
--- /dev/null
+++ b/tests/helpers/n6-source-advisory-review-fixture.mjs
@@ -0,0 +1,158 @@
+import {createServer} from 'vite';
+import {fileURLToPath} from 'node:url';
+
+// Synthetic UI-only fixture. The actual Still client and presenter are used;
+// current authority and provider behavior are deliberately not simulated.
+async function mountReviewFixture() {
+  const {html, LitElement} = await import('/@id/lit');
+  const {StillApp} = await import('/src/still/app.ts');
+  const {StillClient} = await import('/src/still/client.ts');
+  await import('/src/still/vendor/tokens/default.css');
+  await import('/src/still/theme.css');
+  const style = document.createElement('style');
+  style.textContent = (await import('/src/still/style.css?raw')).default.replaceAll('still-app', 'n6-review-fixture');
+  document.head.append(style);
+
+  const trace = window.n6Trace = {requests: [], unexpectedFetches: [], acknowledgedRequests: 0, createdJobs: 0};
+  const injectedText = '<img data-n6-injected="true" src="https://invalid.example/pixel" onerror="window.n6MarkupExecuted=true">';
+  const raw = [
+    ['ProjectCreated', {project_id: 'n6-project', name: 'Synthetic source review'}],
+    ['DocumentCreated', {project_id: 'n6-project', document_id: 'n6-document', title: 'Quiet observatory'}],
+    ...[
+      ['known', 'Creative direction', 'An observatory beside a quiet forest.'],
+      ['empty', 'Category unavailable', injectedText],
+      ['legacy', 'Legacy highlight', 'A blue ceramic cup.'],
+      ['clear', 'Clear isolated input', 'Soft daylight.'],
+    ].map(([block_id, handle, text], index) => ['BlockCreated', {
+      project_id: 'n6-project', document_id: 'n6-document', block_id,
+      type: 'direction', handle, position: String(index + 1), properties: {text, weight: 1, authority: 'authored'},
+    }]),
+  ];
+  const events = raw.map(([type, payload], index) => ({
+    type, payload, sequence: index + 1, eventId: `n6-event-${index}`, streamId: 'n6-synthetic-stream',
+    occurredAt: '2026-09-24T00:00:00.000Z', actor: 'user',
+  }));
+  const issue = {
+    id: 'context-safety', label: 'Source advisory', status: 'warning', severity: 'warning',
+    summary: `Source advisory flagged the overall inputs: hate, violence. Synthetic inert text: ${injectedText}`,
+    blockIds: ['known', 'empty'],
+    sourceVerdicts: [
+      {index: 0, sourceIndex: null, blockId: null, kind: 'snapshot', truncated: false, flagged: true, categories: ['violence'], scores: {violence: .9}},
+      {index: 1, sourceIndex: 0, blockId: 'known', kind: 'fact', truncated: false, flagged: true, categories: ['hate'], scores: {hate: .8}},
+      {index: 2, sourceIndex: 1, blockId: 'empty', kind: 'fact', truncated: false, flagged: true, categories: [], scores: null},
+      {index: 3, sourceIndex: 2, blockId: 'legacy', kind: 'fact', truncated: false, flagged: false, categories: [], scores: null},
+      {index: 4, sourceIndex: 3, blockId: 'clear', kind: 'fact', truncated: false, flagged: false, categories: [], scores: null},
+    ],
+  };
+  const legacy = new URL(location.href).searchParams.get('variant') === 'legacy';
+  if (legacy) { delete issue.sourceVerdicts; issue.blockIds = ['legacy']; }
+  const gate = {error: 'generation_preflight_review_required', readiness: {
+    preflightId: 'n6-synthetic-original-preflight', probes: [issue],
+    advisoryCapture: {status: 'unavailable', reason: 'not-observed', inspection: 'unavailable-before-admission', refs: {}},
+  }};
+  window.n6Readiness = gate.readiness;
+  let releaseAcknowledgement;
+  let app;
+  const state = () => {
+    const draft = app?.generation;
+    document.querySelector('#n6-fixture-state').textContent = JSON.stringify({
+      fixture: 'synthetic-only', variant: legacy ? 'legacy' : 'current', inspection: gate.readiness.advisoryCapture.inspection,
+      ...trace, clientJobs: app?.client.jobs.length ?? 0,
+      acknowledgements: draft?.acknowledgements ?? {},
+      requestId: draft?.requestId ?? null, pending: !!releaseAcknowledgement,
+      destination: window.n6Destination ?? null,
+    }, null, 2);
+  };
+
+  // This intercept exists before the app is attached. No application fetch can
+  // escape to a server; CSP separately blocks non-local subresources.
+  window.fetch = async (input, init = {}) => {
+    const url = new URL(typeof input === 'string' ? input : input.url, location.origin);
+    if (url.origin !== location.origin || url.pathname !== '/api/document-jobs' || init.method !== 'POST') {
+      trace.unexpectedFetches.push({url: url.href, method: init.method ?? 'GET'});
+      state();
+      throw new Error('Synthetic fixture blocked an unexpected fetch.');
+    }
+    const request = JSON.parse(init.body);
+    trace.requests.push(structuredClone(request));
+    state();
+    if (request.payload.preflightAcknowledged !== true) return Response.json(gate, {status: 428});
+    trace.acknowledgedRequests++;
+    await new Promise(resolve => { releaseAcknowledgement = resolve; state(); });
+    trace.createdJobs++;
+    state();
+    return Response.json({job: {
+      jobId: 'n6-synthetic-job', documentId: 'n6-document', requestKey: request.payload.requestKey,
+      status: 'completed', kind: 'generate', sourceSurface: 'still', members: [], attemptCount: 1,
+    }});
+  };
+  document.querySelector('#n6-release').addEventListener('click', () => {
+    const release = releaseAcknowledgement;
+    releaseAcknowledgement = undefined;
+    if (release) release();
+    state();
+  });
+  class FixtureClient extends StillClient {
+    async verifyScope() { return this.fence(); }
+    async checkGenerationReadiness() { return {ready: true, documentId: this.position.documentId}; }
+  }
+  class ReviewFixture extends StillApp {
+    connectedCallback() { LitElement.prototype.connectedCallback.call(this); }
+    updated() { this.scheduleDockFit(); state(); }
+    decide() {}
+    writeRoute() {}
+    currentRouteProblem() { return ''; }
+    navigate(view, ids) { window.n6Destination = {view, ...ids}; this.mode = ''; this.changed(); }
+    render() {
+      return html`<div class="still-shell"><main tabindex="-1">${window.n6Destination
+        ? html`<h1>Synthetic acknowledgement accepted</h1><p>The fixture recorded one synthetic job. No provider was called.</p>`
+        : this.renderCanvas()}</main>${window.n6Destination ? '' : this.renderDock()}${this.renderDockProbes()}${this.renderNotifications()}</div>`;
+    }
+  }
+  customElements.define('n6-review-fixture', ReviewFixture);
+  const client = new FixtureClient();
+  client.session = {user: {userId: 'n6-synthetic-owner', displayName: 'Fixture', role: 'creator'},
+    policy: {accepted: true, retentionDays: 1}, provider: {plannerConfigured: true}, projects: []};
+  client.events = events;
+  client.head = events.length;
+  client.position = {projectId: 'n6-project', documentId: 'n6-document', blockId: '', outputId: '', view: 'document', intent: '', recentActions: []};
+  app = window.n6App = new ReviewFixture();
+  app.loading = false;
+  app.mode = app.routeMode = 'generate';
+  app.client = client;
+  app.generation = client.prepareGeneration('image');
+  app.generation.requestId = 'n6-retained-synthetic-request';
+  client.onChange = () => app.changed();
+  document.querySelector('#n6-product').append(app);
+  await app.updateComplete;
+  state();
+}
+
+export async function createN6ReviewServer({port = 0} = {}) {
+  const server = await createServer({
+    root: fileURLToPath(new URL('../../', import.meta.url)), configFile: false,
+    cacheDir: '/private/tmp/forma-n6-review-vite-cache',
+    optimizeDeps: {noDiscovery: true, include: ['lit', 'lit/async-directive.js', 'lit/directives/if-defined.js', 'lit/directives/keyed.js', 'lit/directives/live.js', 'lit/directives/repeat.js', 'lit/static-html.js', 'qrcode', 'signal-polyfill', 'signal-utils/subtle/reaction']},
+    server: {host: '127.0.0.1', port, strictPort: port !== 0, hmr: false},
+    plugins: [{name: 'n6-source-advisory-synthetic-review', configureServer(vite) {
+      vite.middlewares.use('/api', (_request, response) => {
+        response.writeHead(451, {'content-type': 'application/json', 'cache-control': 'no-store'});
+        response.end(JSON.stringify({error: 'synthetic_fixture_no_server_api'}));
+      });
+      vite.middlewares.use('/n6-review', (_request, response) => {
+        response.writeHead(200, {
+          'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store',
+          'content-security-policy': "default-src 'self'; connect-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
+        });
+        response.end(`<!doctype html><html lang="en"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>N6 synthetic boundary review</title><style>body{margin:0}#n6-fixture-disclosure{font:14px system-ui;padding:12px 20px;background:#fff6d9;color:#362e18}#n6-fixture-disclosure p{margin:4px 0}#n6-fixture-state{max-height:180px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere}#n6-product{position:relative;min-height:700px}</style></head><body><aside id="n6-fixture-disclosure"><strong>N6 synthetic browser fixture</strong><p>Raw pre-admission inspection is unavailable. This fixture reviews the existing N5 summary and explicit acknowledgement flow only. It certifies neither classifier quality nor historical evidence.</p><details><summary>Fixture counters and retained request</summary><pre id="n6-fixture-state"></pre><button id="n6-release" type="button">Finish synthetic acknowledgement</button></details></aside><div id="n6-product"></div><script type="module">(${mountReviewFixture.toString()})().catch(error=>{document.querySelector('#n6-fixture-state').textContent=error.stack;throw error;});</script></body></html>`);
+      });
+    }}],
+  });
+  await server.listen();
+  return {server, url: `http://127.0.0.1:${server.httpServer.address().port}/n6-review`};
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const {url} = await createN6ReviewServer({port: Number(process.env.N6_REVIEW_PORT ?? 4196)});
+  console.log(url);
+}
diff --git a/tests/n6-source-authority-dependency.test.mjs b/tests/n6-source-authority-dependency.test.mjs
new file mode 100644
index 00000000..0fcac088
--- /dev/null
+++ b/tests/n6-source-authority-dependency.test.mjs
@@ -0,0 +1,126 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {registerOutputSourceImports} from './output-execution-test-helpers.mjs';
+
+const imports=registerOutputSourceImports();
+test.after(()=>imports.deregister());
+const {authoritativeCreativeContext}=await import('../worker/context-authority.ts');
+const {serializeEvent}=await import('../worker/event-read-primitives.ts');
+const {publicEventPayload}=await import('../worker/event-privacy.ts');
+const {standingConstraints}=await import('../src/model/taste.ts');
+const {preserveMemoryAuthoredCopies}=await import('../src/model/memory-authorship.ts');
+const {proveCurrentIncarnation}=await import('../worker/generation-current-source-proof.ts');
+
+// Executable dependency counterexamples, not an inspector qualification suite.
+// Every source is synthetic and the real projection/resolver functions run here.
+const event=(sequence,type,payload)=>({eventId:`event-${sequence}`,streamId:'creative:owner',sequence,
+  occurredAt:'2026-01-01T00:00:00.000Z',recordedAt:'2026-01-01T00:00:00.000Z',actor:'user:owner',
+  clientId:'web:editor',correlationId:'synthetic-n6',causationId:null,compensatesEventId:null,schemaVersion:1,type,payload});
+const history=()=>[
+  event(1,'ProjectCreated',{project_id:'project',name:'Synthetic project'}),
+  event(2,'DocumentCreated',{project_id:'project',document_id:'document',title:'Synthetic document'}),
+  event(3,'BlockCreated',{project_id:'project',document_id:'document',block_id:'direction',type:'direction',scope:'document',properties:{text:'A quiet harbor',authority:'authored'},position:'a1'}),
+];
+const resolve=events=>authoritativeCreativeContext(events,{documentId:'document',projectId:'project'});
+const identity=context=>({snapshot:context.snapshot,documentRevision:context.documentRevision,sourceBlockVersions:context.sourceBlockVersions});
+const rowFor=e=>({event_id:e.eventId,stream_id:e.streamId,sequence:e.sequence,occurred_at:e.occurredAt,recorded_at:e.recordedAt,
+  actor:e.actor,client_id:e.clientId,correlation_id:e.correlationId,causation_id:null,compensates_event_id:null,schema_version:1,type:e.type,
+  payload:JSON.stringify(publicEventPayload(e.eventId,e.payload,true).payload),private_json:JSON.stringify(e.payload),
+  private_event_id:e.eventId,owner_id:'owner',project_id:'project',document_id:e.payload.document_id??null,redacted_at:null});
+
+test('N6 dependency: authorized projection identity does not certify private sidecar custody',()=>{
+  const rows=history().map(rowFor),baseline=resolve(rows.map(serializeEvent));
+  for(const changed of [
+    {owner_id:'other-owner'},
+    {project_id:'other-project',document_id:'other-document'},
+    {private_event_id:'other-event'},
+  ]){
+    const altered=rows.map(row=>({...row,...changed}));
+    assert.deepEqual(identity(resolve(altered.map(serializeEvent))),identity(baseline));
+  }
+  // These fields are unavailable after serialization; the resolver cannot
+  // distinguish the rows above without a separately owned custody contract.
+  assert.equal(Object.hasOwn(serializeEvent(rows[2]),'owner_id'),false);
+});
+
+test('N6 dependency: source digest/revision alone does not bind event owner or stream',()=>{
+  const events=history(),baseline=resolve(events);
+  const substituted=events.map(e=>({...e,streamId:'creative:other-owner',actor:'user:other-owner'}));
+  assert.deepEqual(identity(resolve(substituted)),identity(baseline));
+  assert.ok(JSON.stringify(baseline.snapshot).length<28000);
+});
+
+test('N6 dependency: an unavailable private event can still produce a resolver snapshot',()=>{
+  const rows=history().map(rowFor),baseline=resolve(rows.map(serializeEvent));
+  // readProfileEventPage's LEFT JOIN supplies no private_json for a missing or
+  // redacted sidecar. serializeEvent intentionally falls back to public routing.
+  delete rows[2].private_json;
+  const fallback=resolve(rows.map(serializeEvent));
+  assert.equal(fallback.snapshot.facts.length,1);
+  assert.equal(fallback.snapshot.facts[0].properties.text,undefined);
+  assert.notDeepEqual(fallback.snapshot,baseline.snapshot);
+  assert.deepEqual(fallback.snapshot.facts[0].source_event_refs,['event-3']);
+});
+
+test('N6 dependency: selected source refs do not establish the project origin census',()=>{
+  const events=history(),baseline=resolve(events),withoutProject=resolve(events.slice(1));
+  assert.deepEqual(identity(withoutProject),identity(baseline));
+  const selectedRefs=new Set([
+    ...baseline.snapshot.facts.flatMap(f=>f.source_event_refs),
+    ...baseline.snapshot.relationships.flatMap(r=>r.source_event_refs),
+    ...baseline.projection.documents.find(d=>d.id==='document').sourceEvents,
+  ]);
+  assert.equal(selectedRefs.has('event-1'),false);
+  assert.throws(()=>proveCurrentIncarnation(events.slice(1),'document'),/document_origin_unproven/);
+});
+
+test('N6 dependency: standing constraints are a separate source consumer',()=>{
+  const events=history(),withConstraint=[...events,event(4,'PreferenceAuthored',{preference_id:'preference',axis:'exclusion',value:'No lettering',polarity:'forbid'})];
+  assert.deepEqual(identity(resolve(withConstraint)),identity(resolve(events)));
+  assert.equal(standingConstraints(events).length,0);
+  assert.equal(standingConstraints(withConstraint)[0].value,'No lettering');
+  assert.deepEqual(standingConstraints(withConstraint)[0].evidenceRefs,['event-4']);
+  // No assertion that the ordinary Still source-advisory wire contains this
+  // constraint: that wire currently uses the resolver snapshot unchanged.
+});
+
+test('N6 dependency: generation rights validation does not qualify every serialized fact lifetime',()=>{
+  const events=history();
+  events[2].payload.properties={text:'A quiet harbor',weight:0,rights_expires_at:'2000-01-01T00:00:00.000Z'};
+  const inactive=resolve(events);
+  assert.equal(inactive.snapshot.facts[0].active,false);
+  assert.equal(inactive.snapshot.facts[0].properties.rights_expires_at,'2000-01-01T00:00:00.000Z');
+  // Moderation's whole snapshot includes disabled facts, unlike generation's
+  // active-fact rights validation. N6 needs its own complete lifetime receipt.
+  events[2].payload.properties.weight=1;
+  assert.throws(()=>resolve(events),error=>error.code==='context_source_rights_expired');
+});
+
+test('N6 dependency: current properties cannot certify a retained historical source lifetime',()=>{
+  const events=history();
+  events[2].payload.properties.rights_expires_at='2000-01-01T00:00:00.000Z';
+  events.push(event(4,'BlockPropertyEdited',{block_id:'direction',property_path:'rights_expires_at',old_value:'2000-01-01T00:00:00.000Z',new_value:''}));
+  const context=resolve(events);
+  assert.equal(context.snapshot.facts[0].properties.rights_expires_at,'');
+  assert.deepEqual(context.snapshot.facts[0].source_event_refs,['event-3','event-4']);
+  assert.equal(Object.hasOwn(context,'sourceLifetimes'),false);
+});
+
+test('N6 dependency: accepted Memory authorship survives later edits and copied authored work',()=>{
+  const events=history();events[2].payload.memory_authored_version=1;
+  events.push(event(4,'BlockPropertyEdited',{block_id:'direction',property_path:'text',new_value:'A harbor with blue sky'}));
+  const context=resolve(events);
+  assert.equal(context.snapshot.facts[0].authorship,'accepted-memory-assisted');
+  assert.equal(context.snapshot.facts[0].independent_evidence,false);
+  const copied=preserveMemoryAuthoredCopies([{type:'BlockCreated',payload:{block_id:'copy',copied_from_block_id:'direction',properties:{text:'A harbor with blue sky'}}}],context.projection.blocks,events);
+  assert.equal(copied[0].payload.memory_authored_version,1);
+});
